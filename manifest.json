{
  "manifest_version": 3,
  "name": "Base44 Toolkit",
  "version": "4.0.0",
  "description": "Resumable Base44 project backups with a ZIP64 archive engine, persistent export queue, integrity reports and safe restore planning.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Open Base44 Toolkit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://app.base44.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
